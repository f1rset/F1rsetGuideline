FROM ubuntu:22.04

# -------------------- ENV --------------------
ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV SHELL=/bin/zsh

# -------------------- BASE PACKAGES --------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
  git curl wget ca-certificates locales \
  build-essential \
  ripgrep fd-find unzip \
  xclip wl-clipboard \
  zsh \
  && locale-gen en_US.UTF-8 \
  && rm -rf /var/lib/apt/lists/*

# -------------------- NODE.JS --------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
  && apt-get install -y nodejs \
  && npm install -g @mermaid-js/mermaid-cli tree-sitter-cli@0.22.6 \
  && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(uname -m) && \
  if [ "$ARCH" = "x86_64" ]; then FD_ARCH="x86_64-unknown-linux-musl"; else FD_ARCH="aarch64-unknown-linux-musl"; fi && \
  FD_VER="v10.1.0" && \
  curl -fLO "https://github.com/sharkdp/fd/releases/download/${FD_VER}/fd-${FD_VER}-${FD_ARCH}.tar.gz" && \
  tar -xzf "fd-${FD_VER}-${FD_ARCH}.tar.gz" && \
  mv "fd-${FD_VER}-${FD_ARCH}/fd" /usr/local/bin/fd && \
  chmod +x /usr/local/bin/fd && \
  rm -rf "fd-${FD_VER}-${FD_ARCH}"*

RUN ARCH=$(uname -m) && \
  if [ "$ARCH" = "x86_64" ]; then LG_ARCH="x86_64"; else LG_ARCH="arm64"; fi && \
  LG_VER=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*') && \
  curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LG_VER}_Linux_${LG_ARCH}.tar.gz" && \
  tar xf lazygit.tar.gz lazygit && \
  mv lazygit /usr/local/bin/lazygit && \
  rm lazygit.tar.gz

RUN curl --proto '=https' --tlsv1.2 -fsSL https://drop-sh.fullyjustified.net | sh && \
  mv tectonic /usr/local/bin/tectonic

# -------------------- SYMLINK FIXES --------------------
RUN ln -s /usr/bin/fdfind /usr/local/bin/fd && \
  ln -s /usr/bin/npm /usr/local/bin/npm && \
  ln -s /usr/bin/xclip /usr/local/bin/xclip || true && \
  ln -s /usr/bin/wl-copy /usr/local/bin/wl-copy || true

# -------------------- NEOVIM --------------------
# Installing the stable release (0.10+ recommended for LazyVim)
RUN wget -q https://github.com/neovim/neovim/releases/download/v0.11.4/nvim-linux-x86_64.tar.gz -O /tmp/nvim.tar.gz && \
  mkdir -p /opt/nvim && \
  tar -xzf /tmp/nvim.tar.gz -C /opt/nvim && \
  ln -s /opt/nvim/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim && \
  rm /tmp/nvim.tar.gz

# -------------------- LAZYVIM (Lazy.nvim starter) --------------------
RUN mkdir -p /root/.config/nvim \
  && git clone https://github.com/LazyVim/starter /root/.config/nvim \
  && rm -rf /root/.config/nvim/.git

# Configure Zsh as the default shell inside Neovim
RUN mkdir -p /root/.config/nvim/lua/config && \
  echo 'vim.opt.shell = "/bin/zsh"' > /root/.config/nvim/lua/config/options.lua

# Headless sync to install plugins during build
RUN nvim --headless "+Lazy! sync" +qa

# -------------------- OH MY ZSH --------------------
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Plugins
RUN git clone https://github.com/zsh-users/zsh-autosuggestions /root/.oh-my-zsh/custom/plugins/zsh-autosuggestions && \
  git clone https://github.com/zsh-users/zsh-syntax-highlighting /root/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting

RUN sed -i 's/plugins=(git)/plugins=(git zsh-autosuggestions zsh-syntax-highlighting)/' /root/.zshrc && \
  chsh -s /bin/zsh root

WORKDIR /root

CMD ["/bin/zsh"]
